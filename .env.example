# WTFB multi-model connector — environment (ADR 0001)
#
# Copy to `.env` (gitignored) and fill in. The registry
# (.wtfb/ai-harness/model-registry.json) references these NAMES; the real values live here
# and never get committed or synced. Only set what you actually roster — the writer's room
# runs in solo (Claude-only) mode with none of these set.

# --- Self-hosted vLLM (OpenAI-compatible) -----------------------------------------
# Base URL of your vLLM server's OpenAI-compatible API (note the /v1 suffix).
WTFB_VLLM_BASE_URL=http://localhost:8000/v1
# Optional: only if your vLLM gateway enforces an API key. Leave unset for a local, open server.
# WTFB_VLLM_API_KEY=

# --- Optional cloud guest: Google Gemini ------------------------------------------
# WTFB_GEMINI_API_KEY=

# --- Add your own OpenAI-compatible clouds by adding a registry entry + its env vars here,
#     e.g. Together / Fireworks / OpenRouter (all expose /v1/chat/completions).
# WTFB_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# WTFB_OPENROUTER_API_KEY=
